    },
    "Forward 15 seconds" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вперёд на 15 секунд"
          }
        },
        "uk" : {
          "stringUnit" : {
