    "Battery level is available for AirPods and Beats. Other headphones are shown without it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд доступен для AirPods и Beats. Другие наушники показываются без него."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд доступний для AirPods і Beats. Інші навушники показуються без нього."
