    "Briefly show the artwork when a new track starts or playback resumes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ненадолго показывать обложку, когда начинается новый трек или возобновляется воспроизведение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ненадовго показувати обкладинку, коли починається новий трек або відновлюється відтворення."
          }
        }
      }
    },
    "Choose the interface language. The app restarts to apply it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите язык интерфейса. Чтобы применить его, приложение перезапустится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть мову інтерфейсу. Щоб застосувати її, застосунок перезапуститься."
          }
        }
      }
    },
