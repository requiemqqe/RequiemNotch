    "Choose the interface language. The app restarts to apply it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите язык интерфейса. Чтобы применить его, приложение перезапустится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть мову інтерфейсу. Щоб застосувати її, застосунок перезапуститься."
          }
        }
      }
    },
    "Clear history" : {
      "localizations" : {
