    },
    "Fine-tune live notifications so they match the height of your notch exactly." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точно подгоните высоту живых уведомлений под ваш вырез."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точно підженіть висоту живих сповіщень під ваш виріз."
          }
        }
      }
    },
    "Fit to notch" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
